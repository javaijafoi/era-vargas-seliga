      "destaque": "#c062ff",
      "camera": "frente",
      "pilhas": [0, 1, 2, 3]
    },
    {
      "id": "tomba",
      "narracao": "Percebe que, apoiada no cinco, a régua tomba?",
      "texto": "NO 5, A RÉGUA *TOMBA*",
