  "cenas": [
    {
      "id": "gancho",
      "narracao": "Média ponderada é a média em que cada valor tem um peso diferente.",
      "texto": "MÉDIA *PONDERADA*",
      "camera": "frente"
    },
    {
      "id": "regua",
      "narracao": "Pensa numa régua de zero a dez, apoiada num ponto, tipo uma gangorra.",
      "texto": "UMA GANGORRA DE *0 A 10*",
      "camera": "lado"
    },
    {
      "id": "prova",
      "narracao": "Cada nota vira uma pilha de blocos, e o peso é a quantidade de blocos. Prova: nota oito, peso três.",
      "texto": "PROVA: NOTA 8, PESO *3*",
      "destaque": "#3dd6f5",
      "camera": "frente",
      "pilhas": [0]
    },
    {
      "id": "trabalho",
